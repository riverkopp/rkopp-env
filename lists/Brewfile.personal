# Personal-only packages.
#
# `make fresh` installs these on top of lists/Brewfile when etc/profile.txt says
# `personal`, and skips the file entirely on a professional machine. `make sync`
# asks where each newly installed package belongs and appends the personal ones
# here, so they never reach the shared list.

# Game engine
cask "godot"
# Voice and text chat
cask "discord"
# Music streaming
cask "spotify"
# Open-source software for live streaming and screen recording
cask "obs"
# Messaging app with a focus on speed and security
cask "telegram"
