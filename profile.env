# Identity for this repo. Single source of truth.
#
# Build scripts read PDF_SLUG to name generated files. The remaining values
# are the source of truth for the contact line written into resumes and cover
# letters: when one of them changes, change it here and the masters, and the
# agent will carry it into anything generated afterward.
#
# Files already under docs/submitted/ are frozen records of what was actually
# sent. Do not retroactively rewrite them when these values change.
#
# Shell-sourced by hack/generate_pdfs.sh and the docs-to-pdf workflow, and
# parsed by hack/win_generate_pdfs.ps1. Keep it to plain KEY="value" with no
# spaces around the equals sign, no command substitution, and no shell logic.
# Always quote values: an unquoted value containing a space breaks sourcing.

# Used by build scripts: output is docs/pdf/<PDF_SLUG>-resume-<name>.pdf
PDF_SLUG="river-kopp"

# Used when generating documents
FULL_NAME="River Kopp"
LOCATION="Saint Paul, MN"
PHONE="507-299-0445"
EMAIL="followtheriversong@proton.me"
LINKEDIN="linkedin.com/in/calebmkopp"

# Master documents CI converts to PDF and attaches to a release, space
# separated, paths relative to the repo root. Everything else under docs/ is
# a local build only.
CI_PUBLISH_DOCS="docs/masters/visual.md"
